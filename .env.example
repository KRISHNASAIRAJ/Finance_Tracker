# .env.example — Required Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file

# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<supabase-ref>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:<password>@db.<supabase-ref>.supabase.co:5432/postgres

# ─── SUPABASE ───────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (backend only — NEVER expose to mobile)
SUPABASE_ANON_KEY=eyJ...     # anon/public key (safe for mobile)

# ─── ANTHROPIC (Claude API) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── FIREBASE (FCM Push Notifications) ──────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=<base64-encoded service-account.json>
FIREBASE_PROJECT_ID=krishnas-tracker-xxxxx

# ─── KITE CONNECT (Phase 5 only — verify pricing first) ─────
KITE_API_KEY=xxxx
KITE_API_SECRET=xxxx
KITE_REDIRECT_URL=https://<your-backend>/kite/callback

# ─── SECURITY ───────────────────────────────────────────────
ENCRYPTION_SECRET_KEY=<32-byte hex string — generate with: openssl rand -hex 32>
JWT_SECRET=<random 64-char string>

# ─── APP SETTINGS ───────────────────────────────────────────
APP_ENV=development   # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── AI RATE LIMITS (optional override) ─────────────────────
AI_RATE_LIMIT_TNC_QA=30        # calls per day
AI_RATE_LIMIT_PORTFOLIO=5      # calls per day
AI_RATE_LIMIT_SMS_PARSE=50     # calls per day

# ─── CRON SCHEDULE ──────────────────────────────────────────
PORTFOLIO_REPORT_CRON=0 15 * * *   # 3:00 PM UTC = 8:30 PM IST
PORTFOLIO_REPORT_TIMEZONE=Asia/Kolkata
