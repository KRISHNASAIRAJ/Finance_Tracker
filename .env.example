# .env.example — Required Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file
# 
# Architecture: BaaS-first (no FastAPI). See ADR/ADR-008-baas-first.md.

# ─── SUPABASE ───────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...     # service_role key (Edge Functions only — NEVER expose to mobile)
SUPABASE_ANON_KEY=sb_publishable_...  # anon/public key (safe for mobile)

# ─── DATABASE ───────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ─── GROQ (Llama API) ────────────────────────────────────────
# Set via supabase secrets in production. Groq has a generous free tier.
# Models used:
#   llama-3.3-70b-versatile — Card T&C RAG, portfolio recommendations
#   llama-3.1-8b-instant   — SMS parsing fallback
GROQ_API_KEY=gsk_...

# ─── DEEPSEEK (fallback/alternative AI provider) ─────────────
# Used by ai-portfolio-recommend when set (overrides Groq for that function).
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash       # optional; default deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # optional

# ─── FIREBASE (FCM Push Notifications) ──────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=<base64-encoded service-account.json>
FIREBASE_PROJECT_ID=krishnas-tracker-xxxxx

# ─── KITE CONNECT (Phase 4 only — verify pricing first) ─────
KITE_API_KEY=xxxx
KITE_API_SECRET=xxxx

# ─── SECURITY ───────────────────────────────────────────────
ENCRYPTION_SECRET_KEY=<32-byte hex string — generate with: openssl rand -hex 32>
JWT_SECRET=<random 64-char string>

# ─── CRON SCHEDULE (Phase 4 — pg_cron) ──────────────────────
PORTFOLIO_REPORT_CRON=30 15 * * *   # 3:00 PM UTC = 8:30 PM IST
PORTFOLIO_REPORT_TIMEZONE=Asia/Kolkata
