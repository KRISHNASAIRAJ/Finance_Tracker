<?xml version="1.0" encoding="utf-8"?>
<!--
  SleepStatsWidget — 2x2 sleep-only widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).

  The compact view of the last night: the duration, the bedtime → wake time,
  the wake-ups and the sleep rating, with the two REM windows marked on the
  dotted timeline inside the red pill. The red pill fills the space between
  the duration and the details, so there is no empty gap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_stats_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Label -->
    <TextView
        android:id="@+id/sleep_stats_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="LAST NIGHT"
        android:textColor="@color/oxygen_muted"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Duration — "8H 42M" -->
    <TextView
        android:id="@+id/sleep_stats_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:text="—"
        android:textColor="@color/oxygen_white"
        android:textSize="22sp" />

    <!-- Sleep pill with the REM timeline — it fills the free space -->
    <RelativeLayout
        android:id="@+id/sleep_stats_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:minHeight="28dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="7dp"
        android:paddingEnd="7dp">

        <!-- The night ribbon: a bold white bar that spans the whole night
             (bedtime → wake time). The two REM windows are cut out of it in
             the OnePlus red, so they read as gaps in the ribbon. -->
        <TextView
            android:id="@+id/sleep_stats_ribbon"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:background="@drawable/widget_sleep_ribbon"
            android:text="" />

        <ProgressBar
            android:id="@+id/sleep_stats_rem1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />

        <ProgressBar
            android:id="@+id/sleep_stats_rem2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />
    </RelativeLayout>

    <!-- Bed → wake + rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep_stats_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white_dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="→"
            android:textColor="@color/oxygen_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sleep_stats_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white_dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/sleep_stats_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_red"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Wake-ups -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="WAKE-UPS"
            android:textColor="@color/oxygen_muted"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/sleep_stats_wakeups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
