<?xml version="1.0" encoding="utf-8"?>
<!--
  SleepStatsWidget — 2x2 sleep-only widget (OnePlus OxygenOS: black, white,
  the violet sleep accent).

  The last night on the black shell: the duration, the DEEP / LIGHT / AWAKE
  stage chart (drawn from the shared motion timeline), the bed → wake times,
  the wake-ups and the sleep rating.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_stats_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Label -->
    <TextView
        android:id="@+id/sleep_stats_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="LAST NIGHT"
        android:textColor="@color/oxygen_muted"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Duration — "8H 42M" -->
    <TextView
        android:id="@+id/sleep_stats_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:text="—"
        android:textColor="@color/oxygen_white"
        android:textSize="22sp" />

    <!-- The stage chart — DEEP / LIGHT / AWAKE lanes, fills the free space -->
    <LinearLayout
        android:id="@+id/sleep_stats_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- DEEP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="DEEP"
                android:textColor="#B4A8FF"
                android:textSize="5sp" />

            <RelativeLayout
                android:id="@+id/sleep_stats_deep_track"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/sleep_stats_deep_1"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_deep_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_deep_2"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_deep_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_deep_3"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_deep_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_deep_4"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_deep_bar" />
            </RelativeLayout>
        </LinearLayout>

        <!-- LIGHT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="LIGHT"
                android:textColor="#D9D2FF"
                android:textSize="5sp" />

            <RelativeLayout
                android:id="@+id/sleep_stats_light_track"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/sleep_stats_light_1"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_light_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_light_2"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_light_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_light_3"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_light_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_light_4"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_light_bar" />
            </RelativeLayout>
        </LinearLayout>

        <!-- AWAKE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="AWAKE"
                android:textColor="#FF8B96"
                android:textSize="5sp" />

            <RelativeLayout
                android:id="@+id/sleep_stats_awake_track"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/sleep_stats_awake_1"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_awake_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_awake_2"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_awake_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_awake_3"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_awake_bar" />

                <ProgressBar
                    android:id="@+id/sleep_stats_awake_4"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_alignParentTop="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_stats_awake_bar" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bed → wake + rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep_stats_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white_dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="→"
            android:textColor="@color/oxygen_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sleep_stats_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white_dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/sleep_stats_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_red"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Wake-ups -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="WAKE-UPS"
            android:textColor="@color/oxygen_muted"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/sleep_stats_wakeups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/oxygen_white"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
