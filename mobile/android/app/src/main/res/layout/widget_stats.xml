<?xml version="1.0" encoding="utf-8"?>
<!--
  StatsWidget — 2x2 home-screen carousel (OnePlus OxygenOS: black, white, the
  OnePlus red as the accent).

  Seven stat cards (monthly spend, CC bills, bank balance, net lent/debit,
  tasks left, net worth and today's market performance) live in a ViewFlipper
  that auto-advances every 3 seconds with a fade; tapping a card deep-links to
  that screen. The ANIMATION is exactly as it was — only the styling follows
  the OxygenOS palette.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg">

    <ViewFlipper
        android:id="@+id/stats_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:flipInterval="3000"
        android:autoStart="true"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out"
        android:animateFirstView="false">

        <!-- Card 1 — monthly spend -->
        <LinearLayout
            android:id="@+id/stats_card_spend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_spend_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="MONTHLY SPEND"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_spend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Card 2 — credit card bills -->
        <LinearLayout
            android:id="@+id/stats_card_cards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_cards_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CC BILLS"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Card 3 — bank balance -->
        <LinearLayout
            android:id="@+id/stats_card_bank"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_bank_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="BANK BALANCE"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_bank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Card 4 — net lent / net debit -->
        <LinearLayout
            android:id="@+id/stats_card_lent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_lent_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="NET LENT"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_lent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Card 5 — tasks (the header + the nearest 2 tasks, each with a
             circle to tick it off). The card appears twice in the flipper so
             it dwells ~6 s while the other cards keep their 3 s. -->
        <LinearLayout
            android:id="@+id/stats_card_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stats_tasks_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="TASKS LEFT"
                    android:textColor="@color/oxygen_white"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/stats_tasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="@color/oxygen_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_task_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/stats_task_circle_1"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Mark done"
                    android:src="@drawable/widget_task_circle" />

                <TextView
                    android:id="@+id/stats_task_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/oxygen_white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_task_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/stats_task_circle_2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Mark done"
                    android:src="@drawable/widget_task_circle" />

                <TextView
                    android:id="@+id/stats_task_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/oxygen_white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The tasks card again — it dwells longer so the circles can be
             tapped (the flipper's interval is the same for every card). -->
        <LinearLayout
            android:id="@+id/stats_card_tasks_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stats_tasks_label_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="TASKS LEFT"
                    android:textColor="@color/oxygen_white"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/stats_tasks_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="@color/oxygen_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_task_row_1_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/stats_task_circle_1_b"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Mark done"
                    android:src="@drawable/widget_task_circle" />

                <TextView
                    android:id="@+id/stats_task_name_1_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/oxygen_white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_task_row_2_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/stats_task_circle_2_b"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Mark done"
                    android:src="@drawable/widget_task_circle" />

                <TextView
                    android:id="@+id/stats_task_name_2_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/oxygen_white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 6 — net worth -->
        <LinearLayout
            android:id="@+id/stats_card_wealth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_wealth_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="NET WEALTH"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_wealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Card 7 — today's market performance (day change + net value) -->
        <LinearLayout
            android:id="@+id/stats_card_market"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/stats_market_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="MARKET TODAY"
                android:textColor="@color/oxygen_white"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/stats_market_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/oxygen_red"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/stats_market_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="—"
                android:textColor="@color/oxygen_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
