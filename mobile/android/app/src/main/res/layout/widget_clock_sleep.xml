<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget — 2x2 home-screen widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).

  A live clock (TextClock keeps itself up to date, seconds included) with the
  last night of sleep underneath: the red pill holds the sleep duration (in the
  raised island on the right) and the two REM windows marked on the dotted
  timeline.

  The typography is justified: the date and the time are flush left and the
  seconds sit on the time's baseline. The red pill FILLS the remaining height
  (layout_weight), so there is never an empty gap below it.

  Nothing overlaps: the date has its own row, the clock its own row and the
  timeline bars (REM 1, REM 2, dots) are stacked at the bottom of the pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Date -->
    <TextClock
        android:id="@+id/clock_sleep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/oxygen_muted"
        android:textSize="10sp" />

    <!-- Clock — "09:34" + seconds "53" (the seconds sit on the time's baseline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_white"
            android:textSize="26sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Sleep -->
    <TextView
        android:id="@+id/clock_sleep_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:text="SLEEP"
        android:textColor="@color/oxygen_muted"
        android:textSize="8sp"
        android:textStyle="bold" />

    <!-- The red sleep pill: it FILLS the rest of the widget (weight), the
         duration sits in the raised island on the right and the timeline
         (REM 1, REM 2, dots) is stacked at the bottom. -->
    <RelativeLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:minHeight="32dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="7dp"
        android:paddingEnd="7dp">

        <TextView
            android:id="@+id/clock_sleep_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/oxygen_ink"
            android:textSize="12sp" />

        <!-- The night ribbon: a bold white bar that spans the whole night
             (bedtime → wake time). The two REM windows are cut out of it in
             the OnePlus red, so they read as gaps in the ribbon. -->
        <TextView
            android:id="@+id/clock_sleep_ribbon"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:background="@drawable/widget_sleep_ribbon"
            android:text="" />

        <ProgressBar
            android:id="@+id/clock_sleep_rem1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />

        <ProgressBar
            android:id="@+id/clock_sleep_rem2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />
    </RelativeLayout>
</LinearLayout>
