<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget � 2x2 home-screen widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).

  Structure (top to bottom, everything in fixed dp/sp so the content always
  fits the 2x2 box � nothing may overflow onto the stats row):

    date row        9sp
    clock row       19sp
    red pill        weight=1 � the SLEEP block:
                      - raised tab top-right (fixed 30dp tall):
                          duration  12sp bold ink #1A0006
                          score row "Score 55" 5sp #3A0010 + 40dp x 2dp track
                      - "SLEEP" caption 5sp grey in the black notch, left
                      - DEEP / LIGHT / AWAKE lanes (fixed rows) below the tab
                      - bed/wake times 5sp pale pink #FFD6DE inside the bottom
    stats row       ALARM (red) | BATT (white) | TEMP (white)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Date -->
    <TextView
        android:id="@+id/clock_sleep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/oxygen_muted"
        android:textSize="9sp" />

    <!-- Clock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_red"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="@color/oxygen_white"
            android:textSize="19sp" />

        <TextClock
            android:id="@+id/clock_sleep_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_white"
            android:textSize="19sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_faint"
            android:textSize="10sp" />

        <TextClock
            android:id="@+id/clock_sleep_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a"
            android:format24Hour="a"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- The red SLEEP block -->
    <RelativeLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="6dp"
        android:paddingTop="0dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp">

        <!-- The raised tab (top right): duration over the score row -->
        <LinearLayout
            android:id="@+id/clock_sleep_island"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="2dp"
            android:orientation="vertical"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/clock_sleep_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="�"
                android:textColor="#1A0006"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- The score row: "Score 55" + a 2dp black-ink track -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clock_sleep_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Score"
                    android:textColor="#3A0010"
                    android:textSize="5sp" />

                <ProgressBar
                    android:id="@+id/clock_sleep_score"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="38dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_sleep_score_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- The SLEEP caption � sits in the black notch above the red body -->
        <TextView
            android:id="@+id/clock_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.15"
            android:text="SLEEP"
            android:textColor="#A8A8A8"
            android:textSize="5sp"
            android:textStyle="bold" />

        <!-- The stage chart � tracks and dotted AWAKE timeline are drawable
             backgrounds; the bars are horizontal ProgressBars positioned by
             padding, so the RemoteViews payload stays tiny (no bitmaps).
             Fixed 30dp marginTop keeps the lanes directly under the tab,
             fully inside the red body. -->
        <RelativeLayout
            android:id="@+id/clock_sleep_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- DEEP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.11"
                        android:text="DEEP"
                        android:textColor="#FFE3E8"
                        android:textSize="5sp" />

                    <RelativeLayout
                        android:id="@+id/clock_sleep_deep_track"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_sleep_lane_track">

                        <ProgressBar
                            android:id="@+id/clock_sleep_deep_1"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_deep_2"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_deep_3"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_deep_4"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_deep_bar" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- LIGHT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.11"
                        android:text="LIGHT"
                        android:textColor="#FFE3E8"
                        android:textSize="5sp" />

                    <RelativeLayout
                        android:id="@+id/clock_sleep_light_track"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_sleep_lane_track">

                        <ProgressBar
                            android:id="@+id/clock_sleep_light_1"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_light_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_light_2"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_light_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_light_3"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_light_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_light_4"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_light_bar" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- AWAKE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.11"
                        android:text="AWAKE"
                        android:textColor="#FFE3E8"
                        android:textSize="5sp" />

                    <RelativeLayout
                        android:id="@+id/clock_sleep_awake_track"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_sleep_lane_track">

                        <TextView
                            android:id="@+id/clock_sleep_awake_dots"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_centerVertical="true"
                            android:background="@drawable/widget_sleep_awake_dots"
                            android:text="" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_awake_1"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_awake_2"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_awake_3"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                        <ProgressBar
                            android:id="@+id/clock_sleep_awake_4"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_alignParentTop="true"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_sleep_awake_bar" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- No night in the log yet -->
            <TextView
                android:id="@+id/clock_sleep_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.11"
                android:text="No sleep data"
                android:textColor="#FFE3E8"
                android:textSize="5sp"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Bed and wake times directly below the AWAKE lane (the reference look) -->
        <TextView
            android:id="@+id/clock_sleep_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#FFD6DE"
            android:textSize="5sp" />

        <TextView
            android:id="@+id/clock_sleep_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#FFD6DE"
            android:textSize="5sp" />
    </RelativeLayout>

    <!-- The stats row (Alarm, Batt, Temp) -->
    <LinearLayout
        android:id="@+id/clock_sleep_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <!-- ALARM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_alarm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_red"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock_sleep_alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="ALARM"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- BATT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_batt_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="�"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_batt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="BATT"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- TEMP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_temp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="�"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_temp_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="TEMP"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
