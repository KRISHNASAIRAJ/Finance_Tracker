<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget — 2x2 home-screen widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Date -->
    <TextView
        android:id="@+id/clock_sleep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/oxygen_red"
        android:textSize="12sp" />

    <!-- Clock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_red"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="@color/oxygen_white"
            android:textSize="23sp" />

        <TextClock
            android:id="@+id/clock_sleep_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_white"
            android:textSize="23sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_faint"
            android:textSize="11sp" />

        <TextClock
            android:id="@+id/clock_sleep_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a"
            android:format24Hour="a"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- The red SLEEP block -->
    <RelativeLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <!-- The island (top right): duration over score -->
        <TextView
            android:id="@+id/clock_sleep_duration"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="start"
            android:paddingStart="12dp"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="—"
            android:textColor="@color/oxygen_ink"
            android:textSize="8sp" />

        <!-- The SLEEP caption — sits in the black cut-out above the red body,
             so it stays a light grey on black (never ink on black). -->
        <TextView
            android:id="@+id/clock_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="13dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="SLEEP"
            android:textColor="@color/oxygen_muted"
            android:textSize="6sp"
            android:textStyle="bold" />

        <!-- The stage chart -->
        <LinearLayout
            android:id="@+id/clock_sleep_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_duration"
            android:layout_marginTop="1dp"
            android:orientation="vertical">

            <!-- DEEP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="DEEP"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_deep_track"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />
                </RelativeLayout>
            </LinearLayout>

            <!-- LIGHT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="LIGHT"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_light_track"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />
                </RelativeLayout>
            </LinearLayout>

            <!-- AWAKE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="AWAKE"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_awake_track"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/clock_sleep_awake_dots"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/widget_sleep_awake_dots"
                        android:text="" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_alignParentTop="true"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bed and wake times positioned cleanly inside the bottom -->
        <TextView
            android:id="@+id/clock_sleep_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/oxygen_ink"
            android:textSize="5.5sp" />

        <TextView
            android:id="@+id/clock_sleep_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/oxygen_ink"
            android:textSize="5.5sp" />
    </RelativeLayout>

    <!-- The stats row (Alarm, Batt, Temp) -->
    <LinearLayout
        android:id="@+id/clock_sleep_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <!-- ALARM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_alarm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_red"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock_sleep_alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="ALARM"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- BATT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_batt_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_batt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="BATT"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- TEMP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_temp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_temp_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="TEMP"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
