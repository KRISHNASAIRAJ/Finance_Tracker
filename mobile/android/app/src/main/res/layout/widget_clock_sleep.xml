<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget: 2x2 home-screen widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).

  Structure (top to bottom, everything in fixed dp/sp so the content always
  fits the 2x2 box; nothing may overflow onto the stats row):

    date row        9sp
    clock row       19sp
    red pill        weight=1: the SLEEP block, rendered as ONE bitmap by
                    SleepBlockRenderer (draws silhouette + tab, SLEEP caption,
                    duration + Score row, lane labels/tracks/bars, dotted
                    awake line, bed/wake times). Three-child row:
                    spacer 3 / ImageView 94 / spacer 3 (GEOMETRY.md).
    stats row       ALARM (red) | BATT (white) | TEMP (white)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Date -->
    <TextView
        android:id="@+id/clock_sleep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/oxygen_muted"
        android:textSize="9sp" />

    <!-- Clock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_red"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="@color/oxygen_white"
            android:textSize="19sp" />

        <TextClock
            android:id="@+id/clock_sleep_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_white"
            android:textSize="19sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_faint"
            android:textSize="10sp" />

        <TextClock
            android:id="@+id/clock_sleep_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a"
            android:format24Hour="a"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- The red SLEEP block: ONE bitmap from SleepBlockRenderer, 292x132 design
         units scaled by the block width. Hosted by a three-child horizontal
         row: spacer 3 / ImageView 94 / spacer 3 (GEOMETRY.md placement, block
         = 94 percent of the row = 20 percent larger area than the previous
         85.8 placement). The row keeps layout_weight=1 with center_vertical
         so the stats row stays pinned to the bottom at any widget height. -->
    <LinearLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3" />

        <ImageView
            android:id="@+id/clock_sleep_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="94"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Sleep stages" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3" />
    </LinearLayout>

    <!-- The stats row (Alarm, Batt, Temp) -->
    <LinearLayout
        android:id="@+id/clock_sleep_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <!-- ALARM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_alarm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_red"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock_sleep_alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="ALARM"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- BATT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_batt_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_batt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="BATT"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- TEMP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_temp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_temp_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.17"
                android:maxLines="1"
                android:text="TEMP"
                android:textColor="@color/oxygen_label"
                android:textSize="5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
