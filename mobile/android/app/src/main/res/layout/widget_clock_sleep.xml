<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget — 2x2 home-screen widget (OnePlus OxygenOS: black, white,
  the OnePlus red as the accent).

  A live clock (TextClock keeps itself up to date) with the last night of
  sleep underneath: the red block holds the duration + the sleep score in the
  raised island on the right, the sleep-stage chart (DEEP / LIGHT / AWAKE) in
  the middle and the bed/wake times at the bottom. Under it the stats row:
  the battery and the temperature.

  Everything is scaled to a 2x2 cell (~110dp): the type is small but the
  spacing is even and nothing overlaps — the date has its own row, the clock
  its own row, the chart sits inside the red block with the lane labels on the
  left and the bars to their right, and the stats row is split by a 1dp
  divider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Date — the provider writes it so the day digits can be coloured
         (the first digit red, the second white) -->
    <TextView
        android:id="@+id/clock_sleep_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/oxygen_muted"
        android:textSize="9sp" />

    <!-- Clock — the hours in the OnePlus red, the minutes in white, then the
         seconds and the AM/PM on the time's baseline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_red"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="@color/oxygen_white"
            android:textSize="18sp" />

        <TextClock
            android:id="@+id/clock_sleep_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/oxygen_white"
            android:textSize="18sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_faint"
            android:textSize="7sp" />

        <TextClock
            android:id="@+id/clock_sleep_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a"
            android:format24Hour="a"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/oxygen_muted"
            android:textSize="7sp" />
    </LinearLayout>

    <!-- The red SLEEP block -->
    <RelativeLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- The island (top right): the duration + the sleep score -->
        <TextView
            android:id="@+id/clock_sleep_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/oxygen_ink"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/clock_sleep_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/clock_sleep_duration"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/oxygen_ink"
            android:textSize="6sp" />

        <!-- The SLEEP caption — in the cut-out of the block (top left) -->
        <TextView
            android:id="@+id/clock_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="SLEEP"
            android:textColor="@color/oxygen_muted"
            android:textSize="6sp"
            android:textStyle="bold" />

        <!-- The stage chart -->
        <LinearLayout
            android:id="@+id/clock_sleep_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_label"
            android:layout_marginTop="1dp"
            android:orientation="vertical">

            <!-- DEEP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="DEEP"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5.5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_deep_track"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_deep_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_deep_bar" />
                </RelativeLayout>
            </LinearLayout>

            <!-- LIGHT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="LIGHT"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5.5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_light_track"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_light_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_light_bar" />
                </RelativeLayout>
            </LinearLayout>

            <!-- AWAKE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="AWAKE"
                    android:textColor="@color/oxygen_ink"
                    android:textSize="5.5sp" />

                <RelativeLayout
                    android:id="@+id/clock_sleep_awake_track"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1">

                    <!-- The dotted line (black at 40 % over the red) -->
                    <TextView
                        android:id="@+id/clock_sleep_awake_dots"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/widget_sleep_awake_dots"
                        android:text="" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_2"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_3"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
            android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />

                    <ProgressBar
                        android:id="@+id/clock_sleep_awake_4"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0.5dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_sleep_awake_bar" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The bed and the wake time -->
        <TextView
            android:id="@+id/clock_sleep_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/oxygen_ink"
            android:textSize="6sp" />

        <TextView
            android:id="@+id/clock_sleep_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_chart"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/oxygen_ink"
            android:textSize="6sp" />
    </RelativeLayout>

    <!-- The stats row: the alarm, the battery and the temperature -->
    <LinearLayout
        android:id="@+id/clock_sleep_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <!-- ALARM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_alarm_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/oxygen_red"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="ALARM"
                android:textColor="@color/oxygen_label"
                android:textSize="6sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- BATT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_batt_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_batt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="BATT"
                android:textColor="@color/oxygen_label"
                android:textSize="6sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="@color/oxygen_divider" />

        <!-- TEMP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sleep_temp_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/oxygen_white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/clock_sleep_temp_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="TEMP"
                android:textColor="@color/oxygen_label"
                android:textSize="6sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
