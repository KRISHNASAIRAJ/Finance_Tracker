<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockSleepWidget — 2x2 home-screen widget.

  A live clock (TextClock keeps itself up to date, seconds included) with the
  last night of sleep underneath: a green pill that holds the sleep duration,
  a dotted timeline with the two REM windows marked on it, and a weather
  readout.

  The clock parts are TextClock views, so no periodic updates are needed; the
  sleep data is pushed from JS through ClockSleepWidgetBridge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_sleep_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_sleep_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Date — "Saturday 17" -->
    <TextClock
        android:id="@+id/clock_sleep_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE d"
        android:format24Hour="EEEE d"
        android:textColor="#EDEDF2"
        android:textSize="12sp" />

    <!-- Clock — "09:34" + seconds "53" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock_sleep_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F4F4F7"
            android:textSize="30sp" />

        <TextClock
            android:id="@+id/clock_sleep_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="4dp"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:textColor="#9C9CA6"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sleep -->
    <TextView
        android:id="@+id/clock_sleep_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="SLEEP"
        android:textColor="#8E8EA0"
        android:textSize="9sp"
        android:textStyle="bold" />

    <RelativeLayout
        android:id="@+id/clock_sleep_pill"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_sleep_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/clock_sleep_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp"
            android:text="—"
            android:textColor="#0B0B0B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/clock_sleep_dots"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/clock_sleep_duration"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_sleep_dots" />

        <ProgressBar
            android:id="@+id/clock_sleep_rem1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignTop="@id/clock_sleep_dots"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />

        <ProgressBar
            android:id="@+id/clock_sleep_rem2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignTop="@id/clock_sleep_dots"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_sleep_rem_bar" />

        <TextView
            android:id="@+id/clock_sleep_rem1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_dots"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="#0B0B0B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clock_sleep_rem1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_rem1_time"
            android:text="REM"
            android:textColor="#0B0B0B"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/clock_sleep_rem2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_dots"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="#0B0B0B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clock_sleep_rem2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clock_sleep_rem2_time"
            android:layout_alignParentEnd="true"
            android:text="REM"
            android:textColor="#0B0B0B"
            android:textSize="8sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <!-- Weather -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/clock_sleep_weather_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Weather"
            android:src="@drawable/widget_cloud" />

        <TextView
            android:id="@+id/clock_sleep_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="19 °C"
            android:textColor="#C6C6D0"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
