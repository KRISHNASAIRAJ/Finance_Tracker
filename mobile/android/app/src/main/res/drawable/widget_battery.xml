<?xml version="1.0" encoding="utf-8"?>
<!--
  The battery — the Android 12+ "pill" shape: a rounded outline with the
  terminal nub on the right and the charge level filled in.

  It is a ProgressBar drawable, so the OnePlus red fill really shows the
  level of the battery (the same trick the REM timeline uses).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The outline + the nub -->
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/oxygen_muted" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item
                android:gravity="right|center_vertical"
                android:width="2dp"
                android:height="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/oxygen_muted" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- The charge level (OnePlus red), clipped from the left -->
    <item
        android:id="@android:id/progress"
        android:bottom="1dp"
        android:left="1dp"
        android:right="3dp"
        android:top="1dp">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/oxygen_red" />
                <corners android:radius="1dp" />
            </shape>
        </clip>
    </item>
</layer-list>
