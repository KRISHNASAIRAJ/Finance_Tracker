<?xml version="1.0" encoding="utf-8"?>
<!-- The red sleep block: a rounded body with a cut-out at the top left (the
     notch the SLEEP caption sits in) and the raised island on the right that
     carries the duration and the sleep score. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="13dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:gravity="top|right"
        android:width="48dp"
        android:height="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="7dp"
                android:topRightRadius="7dp" />
        </shape>
    </item>
</layer-list>
