<?xml version="1.0" encoding="utf-8"?>
<!-- The red sleep block: a rounded body whose top edge sweeps up into the
     raised island in one continuous concave scoop. The cut-out on the top left
     is where the SLEEP caption sits. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Body -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="26dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- The raised island, with the anti-alias-free scoop -->
    <item
        android:gravity="top|right"
        android:width="92dp"
        android:height="48dp"
        android:drawable="@drawable/widget_sleep_bump" />
</layer-list>
