<?xml version="1.0" encoding="utf-8"?>
<!-- The red sleep block: a rounded body with the raised island bump on the
     top right, merged cleanly into a single unified red mass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Body -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- The raised island (top right bump) -->
    <item
        android:gravity="top|right"
        android:width="62dp"
        android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners
                android:topLeftRadius="11dp"
                android:topRightRadius="11dp" />
        </shape>
    </item>
</layer-list>
