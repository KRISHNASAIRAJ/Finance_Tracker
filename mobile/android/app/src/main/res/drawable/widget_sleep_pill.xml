<?xml version="1.0" encoding="utf-8"?>
<!-- The red sleep block: a rounded body with the raised island tab on the
     top right, merged into a single red mass (the reference look).

     Geometry:
       - the body starts at 24dp and the tab is 30dp tall, so they overlap by
         6dp and no seam can appear between them;
       - the tab is a full pill (15dp radius on a 30dp height); its rounded
         left cap sweeps down to the body's straight top edge, forming the
         concave scoop — no extra black carve on top of the red body;
       - the body keeps a rounded TOP-LEFT corner, but a square TOP-RIGHT one,
         so the right edge of the red mass stays straight down to the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Body: rounded top-left and both bottom corners, square top-right -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp" />
        </shape>
    </item>
    <!-- The raised island tab: fully curved pill shape (15dp radius on 30dp height).
         The concave scoop where the tab meets the body is created naturally by
         the tab's rounded left cap above the body's straight top edge — no
         black carve needed (the previous one read as a small black block). -->
    <item
        android:gravity="top|right"
        android:width="88dp"
        android:height="30dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/oxygen_red" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
