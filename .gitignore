android/app/build/
android/build/
*.keystore
!debug.keystore

# iOS build artifacts
ios/Pods/
ios/build/

# Log files
*.log
build.log

# TypeScript cache
tsconfig.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
